EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Google Places API (New) key used in dev builds and on web (src/lib/google-places.ts)
EXPO_PUBLIC_GOOGLE_PLACES_KEY_DEV=your-key-here
# Google Places API (New) key compiled into iOS production builds — restrict to the iOS bundle ID (src/lib/google-places.ts)
EXPO_PUBLIC_GOOGLE_PLACES_KEY_IOS=your-key-here
# Google Places API (New) key compiled into Android production builds (src/lib/google-places.ts)
EXPO_PUBLIC_GOOGLE_PLACES_KEY_ANDROID=your-key-here
# Unsplash access key for city hero photos (src/components/CityHero.tsx, src/lib/hero-photo.ts)
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=your-key-here
